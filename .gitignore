# StreamScribe .gitignore

# Special / Local Bundles
/ffmpeg/*
releases/
release_setup/
dist/
build/

# Virtual environments
.venv/
/.venv/*
/venv/*
/env/*
/ENV/*
env/
venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# IDE / Editor configs
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary Files
*.log
latest_log.txt
build_output.log
streamscribe.log
*.tmp
*.temp
tmp*

# StreamScribe Local Storage & Databases
*.db
*.sqlite
*.sqlite3
streamscribe_settings.json
user_config.json
.streamscribe/
downloads/
test_downloads/
test_h264/

# Large Model Files
*.pt
*.pth
*.bin
*.safetensors
*.onnx
